# ===========================================================================
# Knowledge System configuration (environment overrides)
# ---------------------------------------------------------------------------
# Every value here can also be set in config/default.yaml. Environment
# variables take precedence. All settings are prefixed with KS_.
# Nested config uses a double underscore, e.g. KS_VECTOR__PROVIDER.
# ===========================================================================

# --- Paths -----------------------------------------------------------------
KS_VAULT_PATH=./knowledge-vault
# KS_STATE_DIR is derived as <KS_VAULT_PATH>/.knowledge by default. Only set it
# if you deliberately want derived state (index/manifest) stored elsewhere.
# KS_STATE_DIR=./knowledge-vault/.knowledge

# --- Ingestion -------------------------------------------------------------
KS_INGEST__INBOX_DIR=00-Inbox
KS_INGEST__AUTO_GIT_COMMIT=false
KS_INGEST__MOVE_PROCESSED_SOURCES=true
KS_INGEST__WATCH_DEBOUNCE_SECONDS=2.0

# --- Converter -------------------------------------------------------------
# Options: markitdown | auto (falls back to a builtin text converter)
KS_CONVERTER__PROVIDER=auto

# --- Embeddings ------------------------------------------------------------
# Options: sentence_transformers | openai | hash (deterministic fallback)
KS_EMBEDDING__PROVIDER=hash
KS_EMBEDDING__MODEL=sentence-transformers/all-MiniLM-L6-v2
KS_EMBEDDING__DIM=384
# For an external OpenAI-compatible embedding endpoint:
# KS_EMBEDDING__PROVIDER=openai
# KS_EMBEDDING__BASE_URL=http://localhost:11434/v1
# KS_EMBEDDING__API_KEY=ollama
# KS_EMBEDDING__MODEL=nomic-embed-text

# --- Vector store ----------------------------------------------------------
# Options:
#   memory       - dependency-free fallback (no extras needed)
#   qdrant_local - real Qdrant, embedded & persisted on disk. NO DOCKER NEEDED.
#   qdrant       - Qdrant server over HTTP (Docker/remote); best at scale
#                  because it supports payload indexes for metadata filters.
#
# This is the only setting that needs to differ between machines. The Markdown
# vault is the source of truth, so on each machine you simply run
# `knowledge rebuild-vector-index` to (re)build the local index.
KS_VECTOR__PROVIDER=qdrant_local
KS_VECTOR__COLLECTION=knowledge
# Server mode only:
# KS_VECTOR__PROVIDER=qdrant
# KS_VECTOR__URL=http://localhost:6333
# KS_VECTOR__API_KEY=

# --- LLM (optional reasoning / enrichment) ---------------------------------
# Options: openai | null
KS_LLM__PROVIDER=null
KS_LLM__BASE_URL=http://localhost:11434/v1
KS_LLM__API_KEY=ollama
KS_LLM__MODEL=llama3.2:3b

# Enrichment mode: off | on | selective
KS_LLM__ENRICHMENT_MODE=selective

# --- Jev (optional structured classification/decision provider) ------------
# Options: stub | (real adapter name once SDK available)
KS_JEV__PROVIDER=stub
KS_JEV__ENABLED=false

# --- API -------------------------------------------------------------------
KS_API__HOST=127.0.0.1
KS_API__PORT=8000

# --- Public tunnel (ngrok; runs locally, nothing is deployed) ---------------
# The free plan gives ONE stable dev domain, so you add the claude.ai connector
# only once. Setup:
#   1) sign up free at ngrok.com and copy your authtoken
#   2) .\tools\ngrok.exe config add-authtoken <TOKEN>
KS_TUNNEL__PROVIDER=ngrok
KS_TUNNEL__MCP_PORT=8765
# Optional: pin the domain from ngrok dashboard -> Universal Gateway -> Domains.
# Pinning means the panel can show the URL before the tunnel finishes booting.
# KS_TUNNEL__NGROK_DOMAIN=your-assigned-name.ngrok-free.dev
